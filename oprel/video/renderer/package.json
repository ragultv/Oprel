{
  "name": "oprel-video-renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Oprel Video Studio render worker (Remotion). Spawned by oprel.video as a child process.",
  "scripts": {
    "video:validate": "tsx bin/worker.ts validate",
    "video:preview": "tsx bin/worker.ts preview",
    "video:render": "tsx bin/worker.ts render",
    "video:check": "tsx bin/worker.ts check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/fiber": "9.8.2",
    "@remotion/bundler": "4.0.538",
    "@remotion/fonts": "^4.0.538",
    "@remotion/renderer": "4.0.538",
    "@remotion/three": "4.0.538",
    "pngjs": "^7.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.538",
    "three": "0.180.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.14",
    "@types/three": "0.180.0",
    "tsx": "4.20.6",
    "typescript": "5.7.3",
    "vitest": "3.2.4"
  }
}
